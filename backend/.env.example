# ---------------------------------------------------------------------------
# AI Club backend – example environment file.
# Copy to `.env` and adjust the values for your machine.
# ---------------------------------------------------------------------------

# Node environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Postgres connection string (matches docker-compose.yml)
DATABASE_URL=postgresql://aiclub:aiclub@localhost:5433/aiclub?schema=public

# Secret used to sign JWTs – CHANGE THIS IN PRODUCTION
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# The single frontend origin allowed to send credentialed CORS requests
CORS_ORIGIN=http://localhost:5173

# Seed admin credentials (change these in production!)
ADMIN_EMAIL=admin@club.test
ADMIN_PASSWORD=admin123
ADMIN_NAME=Club Admin

# Public base URL used to build absolute media URLs
PUBLIC_BASE_URL=http://localhost:4000
